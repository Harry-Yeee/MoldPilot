DATABASE_URL="postgresql://moldpilot:moldpilot@localhost:5432/moldpilot?schema=public"

# Required on a production server. Generate with `openssl rand -hex 32`.
# MOLDPILOT_SESSION_SECRET=

# Production launchers require this marker and reject local pilot/seed commands.
# Leave it unset for a normal development checkout.
# MOLDPILOT_DEPLOYMENT_MODE=production

# Preferred factory deployment: HTTPS through the approved reverse proxy. In
# this mode Next remains on 127.0.0.1:3000.
# MOLDPILOT_BASE_URL=https://192.168.1.50
# MOLDPILOT_SESSION_COOKIE_SECURE=auto
# MOLDPILOT_TRUST_PROXY=1
# MOLDPILOT_TRUSTED_CIDR=192.168.1.0/24

# Temporary isolated-LAN HTTP mode (not internet-safe): use the Mac mini's
# stable LAN address and port. `auto` resolves Secure=false so login works over
# HTTP; credentials and cookies are not encrypted in transit.
# MOLDPILOT_BASE_URL=http://192.168.1.50:3000
# MOLDPILOT_SESSION_COOKIE_SECURE=auto

# Offline dependency cache location. Must live OUTSIDE the repo (an in-repo cache
# bloats the dev server's file watcher). Defaults to $HOME/.moldpilot-offline.
# MOLDPILOT_OFFLINE_DIR=

# Root directory for uploaded file attachments (photos, QC reports, etc.).
# Defaults to ./storage/uploads relative to the project root (storage/ is
# gitignored). Point this at a persistent local path on the factory Mac.
# MOLDPILOT_STORAGE_DIR=./storage/uploads

# Private staging area. Scanner outages leave uploads here until the automatic
# abandoned-file cleanup removes them; quarantined bytes are never downloadable.
# MOLDPILOT_QUARANTINE_DIR=./storage/quarantine

# Docker injects absolute persistent paths at runtime. These are examples only;
# D2.1 remains a disposable proof and is not production approval.
# MOLDPILOT_STORAGE_DIR=/data/uploads
# MOLDPILOT_QUARANTINE_DIR=/data/quarantine

# Native/Homebrew runtime: scanner mode defaults to local for compatibility.
# Absolute path to local ClamAV `clamscan` or `clamdscan`.
# MOLDPILOT_SCANNER_MODE=local
# MOLDPILOT_SCANNER_COMMAND=/opt/homebrew/bin/clamscan

# Container D2.1 runtime: clamd is private to Docker and must be selected
# explicitly. Values below match the disposable private service. The 320 MiB
# stream ceiling safely covers MoldPilot's current 300 MiB upload maximum.
# MOLDPILOT_SCANNER_MODE=clamd
# MOLDPILOT_CLAMD_HOST=clamav
# MOLDPILOT_CLAMD_PORT=3310
# MOLDPILOT_CLAMD_CONNECT_TIMEOUT_MS=3000
# MOLDPILOT_CLAMD_HEALTH_TIMEOUT_MS=5000
# MOLDPILOT_CLAMD_RESPONSE_TIMEOUT_MS=10000
# MOLDPILOT_CLAMD_SCAN_TIMEOUT_MS=600000
# MOLDPILOT_CLAMD_MAX_STREAM_BYTES=335544320
# MOLDPILOT_READINESS_TIMEOUT_MS=7000

# Where `scripts/run-kpi-snapshot.mjs` archives its signed-at-the-prize-meeting
# JSON snapshot (mode 0600). Leave unset on a configured server: the default is
# <MOLDPILOT_STORAGE_DIR>/kpi-snapshots, which scripts/backup.sh already tars, so
# the archive rides off-machine with the nightly encrypted backup. Falls back to
# ./storage/kpi-snapshots only when MOLDPILOT_STORAGE_DIR is unset. Set this
# explicitly ONLY if you also arrange for that path to be backed up.
# MOLDPILOT_KPI_SNAPSHOT_DIR=./storage/kpi-snapshots

# Production backup destination must be a mounted NAS/external filesystem.
# The age recipient is public; keep the corresponding private identity offline.
# BACKUP_DIR=/Volumes/FactoryBackup/MoldPilot
# BACKUP_AGE_RECIPIENT=age1...

# ── Backup v2: immutable off-site copy (security-hardening-runbook.md §7b) ────
# One Aliyun OSS bucket serves the whole estate; this app owns one prefix inside
# it and one prefix-scoped, no-delete (Put/Get/List) RAM key for that prefix —
# it can upload and read back its own archives, but never delete. The AccessKey
# lives in rclone.conf (mode 0600), never here. Leave these unset and the
# pipeline records the cloud leg as "unconfigured" — the local archive still runs.
# BACKUP_OSS_REMOTE=ljerp-oss
# BACKUP_OSS_BUCKET=lj-erp-backups
# BACKUP_OSS_PREFIX=moldpilot
# BACKUP_RCLONE_CONFIG=/Users/moldpilot/.config/rclone/rclone.conf
# Set to 0 to run the local leg only (a documented decision, not a default).
# BACKUP_OSS_ENABLED=1

# ── Backup v2: nightly unattended restore proof ───────────────────────────────
# A SECOND age recipient, enrolled alongside BACKUP_AGE_RECIPIENT, whose private
# identity lives on this machine at mode 0600 so scripts/backup-verify.sh can
# restore last night's archive without a human. It is NOT the escrowed recovery
# key (§7a), and losing it costs nothing. Read the trade-off in §7b before
# enabling: it means a compromise of this machine can read every archive on the
# backup disk. Unset = the nightly proof records "skipped" and the admin light
# goes amber.
# BACKUP_VERIFY_RECIPIENT=age1...
# BACKUP_VERIFY_IDENTITY_FILE=/Users/moldpilot/.config/lj-erp/moldpilot-verify-identity
# Cloud drill cadence: the nightly verify runs the drill when the last
# SUCCESSFUL drill is older than this many days, or has never run, and retries
# it every night until it passes. There is no fixed drill day — a day-of-month
# trigger was read in UTC (03:30 Beijing = the previous UTC day) and one offline
# night skipped a whole month. Default 30.
# BACKUP_DRILL_MAX_AGE_DAYS=30

# Health file the admin page reads. Defaults to
# <MOLDPILOT_STORAGE_DIR>/backup-status.json, which scripts/backup.sh already
# tars, so the health record rides off-machine with the archive. Set this only
# if you also arrange for that path to be backed up.
# BACKUP_STATUS_FILE=

# Set to 1 on a machine that is EXPECTED to run backups (the production mini).
# The admin health line then reads a missing or corrupt backup-status.json as
# RED instead of the calm "no status yet" state a developer laptop shows: on a
# commissioned install that file is rewritten every night, so its absence is a
# failure, not an absence of news. Leave unset in development.
# BACKUP_EXPECTED=1
